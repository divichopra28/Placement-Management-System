# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# Oracle connection (Easy Connect: host:port/service_name)
ORACLE_USER=placement
ORACLE_PASSWORD=change_me
ORACLE_CONNECT_STRING=localhost:1521/XE

# Oracle Database 11g needs node-oracledb "thick" mode, which loads the Oracle
# Client libraries. With Oracle XE 11g on Windows point this at its bin folder.
# For Oracle 12.1+ you may set ORACLE_DRIVER_MODE=thin and leave the lib dir empty.
ORACLE_DRIVER_MODE=thick
ORACLE_CLIENT_LIB_DIR=C:\oraclexe\app\oracle\product\11.2.0\server\bin

# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
SESSION_HOURS=8
REMEMBER_ME_DAYS=7

# Where uploaded resumes are stored (relative to /backend)
UPLOAD_DIR=uploads

# Only needed if the frontend is served from a different origin
CORS_ORIGIN=
